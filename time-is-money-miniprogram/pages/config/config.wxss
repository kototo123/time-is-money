.container { padding: 16rpx; }
.section { background: #1a1a2e; border-radius: 16rpx; padding: 16rpx 20rpx; margin-bottom: 12rpx; }
.section-header { display: flex; align-items: center; margin-bottom: 12rpx; }
.section-icon { font-size: 28rpx; margin-right: 8rpx; }
.section-title { font-size: 26rpx; font-weight: bold; color: #00d4ff; }

.radio-group { display: flex; gap: 12rpx; margin-bottom: 12rpx; }
.radio-item {
  flex: 1; height: 56rpx; line-height: 56rpx; text-align: center;
  background: #0f0f23; border-radius: 10rpx; font-size: 24rpx;
  color: #8888aa; border: 1px solid transparent;
}
.radio-item.active { background: rgba(0,212,255,0.15); color: #00d4ff; border-color: #00d4ff; }

.input {
  flex: 1; height: 56rpx; background: #0f0f23; border-radius: 10rpx;
  padding: 0 16rpx; font-size: 24rpx; color: #fff; box-sizing: border-box;
}

.row-fields { display: flex; gap: 12rpx; align-items: center; }
.field-group { flex: 1; display: flex; align-items: center; gap: 6rpx; }
.field-label-sm { font-size: 22rpx; color: #8888aa; white-space: nowrap; }
.field-unit { font-size: 22rpx; color: #8888aa; }
.input-sm {
  flex: 1; height: 52rpx; background: #0f0f23; border-radius: 8rpx;
  padding: 0 12rpx; font-size: 22rpx; color: #fff; box-sizing: border-box;
  min-width: 0; display: flex; align-items: center;
}
.picker-sm { line-height: 52rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.cal-btn { justify-content: center; color: #00d4ff; }

.save-btn {
  width: 100%; height: 72rpx; margin-top: 8rpx;
  background: linear-gradient(135deg, #00d4ff, #0077ff);
  border-radius: 36rpx; font-size: 28rpx; border: none; color: #fff;
  display: flex; align-items: center; justify-content: center;
}

/* === Calendar Modal === */
.cal-mask { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 100; }
.cal-modal { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 101; width: 660rpx; }
.cal-modal-inner { background: #1a1a2e; border-radius: 24rpx; padding: 32rpx; border: 1px solid rgba(0,212,255,0.2); }
.cal-nav { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.cal-nav-btn { font-size: 36rpx; color: #00d4ff; padding: 8rpx 24rpx; }
.cal-nav-title { font-size: 30rpx; color: #fff; font-weight: bold; }
.cal-weekday-row { display: flex; margin-bottom: 8rpx; }
.cal-weekday-header {
  flex: 1; text-align: center; padding: 12rpx 0; border-radius: 10rpx;
  font-size: 26rpx; font-weight: bold; margin: 0 4rpx;
}
.cal-weekday-header.on { background: rgba(0,212,255,0.2); color: #00d4ff; }
.cal-weekday-header.off { background: rgba(255,126,179,0.15); color: #ff7eb3; }
.cal-week-row { display: flex; margin-bottom: 4rpx; }
.cal-day-cell {
  flex: 1; text-align: center; padding: 16rpx 0; border-radius: 10rpx;
  font-size: 26rpx; margin: 0 4rpx;
}
.cal-day-cell.empty { visibility: hidden; }
.cal-day-cell.work { background: rgba(0,212,255,0.12); color: #00d4ff; }
.cal-day-cell.rest { background: rgba(255,126,179,0.1); color: #ff7eb3; }
.cal-day-cell.today { border: 2rpx solid #ffd700; font-weight: bold; }
.cal-day-cell.override { box-shadow: 0 0 0 2rpx #ffd700 inset; }
.cal-done {
  display: block; text-align: center; font-size: 28rpx; color: #00d4ff;
  margin-top: 20rpx; padding: 16rpx; font-weight: bold;
}
