.container { padding: 30rpx; }
.page-title { font-size: 32rpx; font-weight: bold; color: #00d4ff; display: block; margin-bottom: 30rpx; }
.summary-card {
  background: linear-gradient(135deg, #1a1a2e, #16213e);
  border-radius: 20rpx; padding: 40rpx; text-align: center;
  margin-bottom: 30rpx; border: 1px solid rgba(255,215,0,0.2);
}
.summary-label { font-size: 28rpx; color: #8888aa; display: block; margin-bottom: 12rpx; }
.summary-amount { font-size: 64rpx; font-weight: bold; color: #ffd700; font-family: 'Courier New', monospace; }
.record-list { background: #1a1a2e; border-radius: 20rpx; padding: 20rpx; }
.empty { text-align: center; padding: 60rpx; color: #8888aa; font-size: 28rpx; }
