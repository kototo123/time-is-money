<view class="container">
  <view class="header">
    <text class="greeting">{{greeting}}</text>
    <text class="date">{{today}}</text>
  </view>

  <view class="money-card">
    <text class="money-label">今日已赚</text>
    <view class="money-roll">
      <text class="symbol">¥</text>
      <view wx:for="{{moneyChars}}" wx:key="id" class="char-box {{item.dot ? 'dot-box' : ''}}">
        <text wx:if="{{!item.dot}}" class="char {{item.changed ? 'roll-in' : ''}}">{{item.ch}}</text>
        <text wx:else class="char dot-char">.</text>
      </view>
    </view>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{percentage}}%"></view>
    </view>
    <text class="progress-text">已完成 {{percentageStr}}%</text>
  </view>

  <view class="info-row">
    <view class="info-item">
      <text class="info-label">今日目标</text>
      <text class="info-value">¥{{dailyTotal}}</text>
    </view>
    <view class="info-item">
      <text class="info-label">每秒入账</text>
      <text class="info-value">¥{{perSecondStr}}</text>
    </view>
  </view>

  <view class="countdown-card {{isWorkTime ? '' : 'is-off-duty'}}">
    <text class="countdown-label">{{countdownLabel}}</text>
    <view class="countdown-roll">
      <view wx:for="{{cdChars}}" wx:key="id" class="char-box {{item.ch === ':' ? 'colon-box' : ''}}">
        <text wx:if="{{item.ch !== ':'}}" class="char {{item.changed ? 'roll-in' : ''}}">{{item.ch}}</text>
        <text wx:else class="char colon-char">:</text>
      </view>
    </view>
    <text class="countdown-status">{{statusText}}</text>
  </view>

  <view class="error-tip" wx:if="{{error}}">
    <text>⚠️ {{error}}</text>
  </view>

  <view class="fish-tip" bindtap="toggleFish">
    <text>{{fishText}}</text>
  </view>
</view>
